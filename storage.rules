rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /covers/{fileName} {
      allow read: if request.auth != null && request.auth.token.allowed == true;
      allow create: if request.auth != null && request.auth.token.allowed == true
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
